#45367=IFCPROPERTYSINGLEVALUE('Balk Balk -2, As D, 1-4',$,IFCLABEL('onder: S51a: 2 \X2\00D8\X0\32 \X2\00D7\X0\ 32700 mm [12200 + 8300 + 12200]; S51b: 2 \X2\00D8\X0\32 \X2\00D7\X0\ 21600 mm [12200 + 9400]; S52: 2 \X2\00D8\X0\32 \X2\00D7\X0\ 9000 mm; S52a: 2 \X2\00D8\X0\32 \X2\00D7\X0\ 5000 mm; S53: 2 \X2\00D8\X0\32 \X2\00D7\X0\ 8300 mm (as 1-2 en as 2-3); S54: 4+4 \X2\00D8\X0\32 \X2\00D7\X0\ 7000 mm | boven: S61a: 3 \X2\00D8\X0\32 \X2\00D7\X0\ 27200 mm; S61b: 2 \X2\00D8\X0\32 \X2\00D7\X0\ 34400 mm; S61c: 1 \X2\00D8\X0\32 \X2\00D7\X0\ 25200 mm; S61d: 1 \X2\00D8\X0\32 \X2\00D7\X0\ 4000 mm; S62: 4+4 \X2\00D8\X0\25 \X2\00D7\X0\ 7200 mm (as 2); S63: 4 \X2\00D8\X0\32 \X2\00D7\X0\ 7200 mm | zijkant: S57a: 2 \X2\00D8\X0\12 \X2\00D7\X0\ 24000 mm alle 250 mm (achter); S57b: 2 \X2\00D8\X0\12 \X2\00D7\X0\ 30300 mm alle 250 mm (voor); S58: 2+2 \X2\00D8\X0\12 \X2\00D7\X0\ 1200 mm alle 250 mm; S64: 16 \X2\00D8\X0\28 \X2\00D7\X0\ 5500 mm; S65: 4 \X2\00D8\X0\20 \X2\00D7\X0\ 2450 mm | beugels: S66: 139 \X2\00D8\X0\12 \X2\00D7\X0\ 5100 mm alle 150 mm; S67: 139 \X2\00D8\X0\12 \X2\00D7\X0\ 1000 mm alle 150 mm; S68: 139 \X2\00D8\X0\12 \X2\00D7\X0\ 1980 mm alle 150 mm; S69: 11 \X2\00D8\X0\12 \X2\00D7\X0\ variabel alle 75 mm; S70: 42 \X2\00D8\X0\12 \X2\00D7\X0\ 3100 mm; S70a: 14 \X2\00D8\X0\12 \X2\00D7\X0\ 3850 mm | knooppunt balk/kolom: S76: 2\X2\00D7\X0\ 4+4 \X2\00D8\X0\25 \X2\00D7\X0\ 2000 mm; S77: 2\X2\00D7\X0\ 2 \X2\00D8\X0\32 \X2\00D7\X0\ 3500 mm; S78: 2\X2\00D7\X0\ 10 \X2\00D8\X0\25 \X2\00D7\X0\ 1400 mm | blad W23 (2007)'),$);
#45368=IFCPROPERTYSINGLEVALUE('Vloer plaat boven +1, as 1-4 H-L',$,IFCLABEL('bron: W57 (2008) | peil: bovenkant plaat +28,17 (het bouwkundige plan van 2010 geeft +28,31 als afgewerkte vloer; het verschil van 14 cm is de vloeropbouw) | systeem: cassettevloer: ribben met vierkante cassettes (types R1, R2 en R5) tussen de balken | basiswapening: gepuntlast net 150/150/10/10; plaatselijk 150/150/6/6 | staven: S228: 4 \X2\00D8\X0\10 \X2\00D7\X0\ 9400 zijkant; S229: 4 \X2\00D8\X0\10 \X2\00D7\X0\ 9400 zijkant; S230: 24 \X2\00D8\X0\6 \X2\00D7\X0\ 1000 alle 100 mm; S231: 12 \X2\00D8\X0\6 \X2\00D7\X0\ 1000 alle 150 mm; S235: 205\X2\00D7\X0\2 \X2\00D8\X0\16 \X2\00D7\X0\ 3000 boven in de ribben; S236: 6\X2\00D7\X0\2 \X2\00D8\X0\16 \X2\00D7\X0\ 3000 boven in de ribben | nota: De bekistingsplannen tonen voor dit niveau voorgespannen welfsels met druklaag; het wapeningsplan toont voor de zone H-L een cassettevloer. Het vloersysteem verschilt dus per zone.'),$);
#45369=IFCPROPERTYSINGLEVALUE('Stramien',$,IFCLABEL('letters: A t.e.m. L, twaalf assen om de 8,80 m (uit de DWG 27.21 Het Ufo, laag 45-aslijnaanduiding) | totale lengte: 96,78 m van as A tot as L | cijfers: 1 t.e.m. 4, dwars op de letters (uit de wapenings- en bekistingsplannen) | richting: de letterassen lopen onder 82,93\X2\00B0\X0\ in de co\X2\00F6\X0\rdinaten van het model | as A: lengteco\X2\00F6\X0\rdinaat 115,1 m; as L op 18,3 m. Welke kant as A is, volgt uit de daken: de zone met de plaat boven +4 (W75: dakbalken +39,82; W76: plaat +39,72; dak +40,04) is in het model de helft met de bovenste verdieping, en die zone heet op de bladen H-L. De zone die op +3 stopt (W69: +35,84; W73: dakbalken +3) heet A-D en ligt aan de andere kant. | cijferassen in het model: vier dwarslijnen op dwarsco\X2\00F6\X0\rdinaat -8,0 / -19,26 / -28,86 / -40,5. De twee buitenste dragen de gevelkolommen (84 en 94 stuks), de twee binnenste elk acht ovale kolommen op de letters C t.e.m. J \X2\2014\X0\ precies de acht die W5 voor as 2 en voor as 3 opsomt. | nog te bepalen: in welke richting de cijfers lopen: of de binnenste dwarslijn op -19,26 as 2 is dan wel as 3. Daardoor liggen de kolomtypes van W5 vast voor de letters C, D en I (zelfde type op beide assen) en nog niet voor E, F, G, H en J. | controle: de acht ovale kolommen per rij staan 7 \X2\00D7\X0\ 8,80 = 61,6 m uit elkaar; gemeten 61,1 m. Hun letters C t.e.m. J volgen rechtstreeks uit de plaats van as A.'),$);
#45370=IFCPROPERTYSINGLEVALUE('Peil plaat boven +1',$,IFCLABEL('+28,17 (as 1-4, H-L) \X2\2014\X0\ blad W57 \X2\2014\X0\ niveau 110 staat op +28,31 (afgewerkte vloer uit het plan van 2010); het verschil van 14 cm is de vloeropbouw boven de constructieve plaat'),$);
#45371=IFCPROPERTYSINGLEVALUE('Peil plaat boven +3, zone A-D',$,IFCLABEL('+35,84 (as 1-4, A-D) \X2\2014\X0\ blad W69 \X2\2014\X0\ de plaat ligt in deze zone 15 cm lager dan in de zone H-L'),$);
#45372=IFCPROPERTYSINGLEVALUE('Peil plaat boven +3, zone H-L',$,IFCLABEL('+35,99 (as 1-4, H-L) \X2\2014\X0\ blad W70 en W71/W72 (balken verdieping +3, peil 35.99) \X2\2014\X0\ niveau 130 staat op +36,13; opnieuw 14 cm vloeropbouw boven de constructieve plaat'),$);
#45373=IFCPROPERTYSINGLEVALUE('Peil plaat boven +4 (dak)',$,IFCLABEL('+39,72 (as 1-4, H-L (deel 2)) \X2\2014\X0\ blad W76 \X2\2014\X0\ de dakbalken staan volgens W75 op peil +39,82; het dak van het model ligt op +40,04'),$);
#45374=IFCPROPERTYSINGLEVALUE('Peil dakbalken verdieping +4',$,IFCLABEL('+39,82 (H\X2\2019\X0\-L\X2\2019\X0\) \X2\2014\X0\ blad W75 \X2\2014\X0\ dakstructuur'),$);
#45375=IFCPROPERTYSINGLEVALUE('Peil bovenkant wand as L\X2\2019\X0\',$,IFCLABEL('+40,04 (as L\X2\2019\X0\) \X2\2014\X0\ blad W66 (wand van +27,28 tot +40,04) \X2\2014\X0\ bevestigt het dakpeil +40,04 dat in dit model gebruikt wordt'),$);
#45376=IFCPROPERTYSINGLEVALUE('Peil bij te storten gedeelte as A-2',$,IFCLABEL('+19,00 (as A-2) \X2\2014\X0\ blad W80 \X2\2014\X0\ lokale aanpassing, niet gemodelleerd'),$);
#45377=IFCPROPERTYSINGLEVALUE('Nummering',$,IFCLABEL('De bekistingsplannen (S) en de wapeningsplannen (W) nummeren de verdiepingen niet gelijk: wat de bekistingsplannen "plaat boven verdieping 0" noemen, heet op de wapeningsplannen "plaat boven +1" (beide +28,17). De peilen in de titels zijn daarom leidend, niet de nummers.'),$);
#45378=IFCPROPERTYSINGLEVALUE('Nog niet geplaatst',$,IFCLABEL('De merken (C-2, as D ...) staan op het stramien A-L / 1-4. De letterassen zijn teruggevonden: twaalf kolomlijnen om de 8,80 m, zoals de DWG ze geeft. Welk uiteinde as A is en waar de cijferassen 1 t.e.m. 4 liggen, moet nog vastgelegd worden; daarna kunnen de staven aan de juiste kolommen en balken gehangen worden.'),$);
#45379=IFCPROPERTYSINGLEVALUE('Overige bladen',$,IFCLABEL('W1: wapening funderingsplaat (1/100); W2: wapening paalkoppen (1/20); W3: wapening paalkoppen en wachtstaven wanden ter plaatse van de liftkokers (1/50-1/20); W4: wachtstaven wanden W1 t.e.m. W7 en circulatiekern as D (1/200-1/50-1/20); W6: wand W1A, niveau -2 en -1; W7: wand W1B, niveau -2 en -1; W8: wand W1C, niveau -2 en -1; W9: wand W2A, niveau -2; W10: wand W2B/C, niveau -2 en -1; W11: wand W3, niveau -2 en -1; W12: wand W4 en W4A/B, niveau -2; W13: wanden kern A en B, niveau -2; W14: wapening plaat boven -2, deel 1 as 1-4, A-D (1/50); W15: wapening plaat boven -2, deel 2 as 1-4, D-H (1/50); W16: wapening plaat boven -2, deel 3 as 1-4, H-L (1/50); W17: technische koker ter plaatse van as 4: wanden W5, W6, W7 + dakplaat (1/50); W18: wanden kern as C en D, niveau -2 (1/50-1/100); W19: trap ter plaatse van assen A-B/1-3 (1/50); W20: plaat boven -2 (1/20); W21: balken boven verdieping -2 (deel 1), as 3: balken 3,A-D / 3,D-H / 3,D-K / 3,K-L; W22: balken boven verdieping -2 (deel 2), as 3: balken 2,A-D / 2,D-H / 2,H-L; W23: balken boven verdieping -2 (deel 3), assen A t.e.m. F \X2\2014\X0\ overgenomen in dit model (as C en as D); W24: balken boven verdieping -2 (deel 4), assen G t.e.m. K: balken G,1-4 / H,1-4 / I,1-4 / J,1-4 / K,1-2; W25: balken boven verdieping -2 (deel 5), assen 4, B, C en K; W26: wanden technisch verdiep 90: WT3, WT5 t.e.m. WT15; W27: bijlegwapening knopen A-J/2-3; W28: wanden technisch verdiep 90: WT16 t.e.m. WT21 en WT23; W29: wapening keermuur (1/25); W30 en W30bis: technische koker deel 2, bijkomende wapening in functie van de verhoging van de wanden; W31: wanden technisch verdiep 90: WT26 t.e.m. WT30; W32: balken boven verdieping -1 (deel 1): balken 3,H-L / 4,H-L; W33: balken boven verdieping -1 (deel 1): balken 1,H-L / 2,H-L; W34: balken boven verdieping -1 (deel 1): balken I,1-4 / J,1-4 / K,1-4 / K\X2\2019\X0\,2-3; W35: balken boven verdieping -1 (deel 3): balken 4,A-D / 3,A-D / 2,B-D / 1,B-D; W36: balken boven verdieping -1 (deel 3): balken A,3-4 / B,1-4 / C,1-4; W37: wapening plaat boven -1, deel 3 as 1-4, H-L (1/50); W38: wapeningsplan (1/50 - 1/20); W39: wapening plaat boven -1, deel 1 as 1-4, A-D (1/50); W40: balken boven verdieping -1 (deel 2): balken 1,D-H / 2,D-E / 2,F-H / 3,D-E / 4,D-H; W41: balken boven verdieping -1 (deel 2): balken D,1-2 / E,1-4 / F,1-2 / G,1-3 / H,1-3; W42: wanden technisch verdiep 90: WT31 t.e.m. WT42; W43: wapening plaat boven -1: schuine plaat foyer; W44: wapening plaat boven -1, deel 2 as 1-4, D-H; W45: balken boven verdieping -1: knooppuntwapening en principeplaatjes; W46: wapening bodemplaat auditorium, wanden W55, W56 en W57, en het trapje naar het auditorium; W47: wanden W22, W49, W50, W51, W52 en W53; W48: wanden W43, W44, W45, W46, W47 en W48; W49: wand auditorium as 1; W50: wand auditorium as 4; W51: wand auditorium W41 as D; W52: wand auditorium W42 as H; W53: wapening wandje onder de trap van de foyer; W54: wapening vervalput ter plaatse van as L-4; W55: balken verdieping +1: B+1 H\X2\2019\X0\,2-3 / I,1-4 / J,1-4 / K,1-3 / K,3\X2\2019\X0\-4 / K\X2\2019\X0\,1-4 / L,1-2 / L,3-4; W56: balken verdieping +1: B+1 1,H-L / 2,H-L / 3,H-L / 4,H-L; W57: wapening plaat boven +1 (niveau +28,17), deel 3 as 1-4, H-L \X2\2014\X0\ cassettevloer; W58: wapening plaat boven +1, deel 1 as 1-4, A-D; W59: balken verdieping +1: B+1 A,1-4 / A\X2\2019\X0\,2-3 / B,1-2 / B,2-4 / C,1-4 / C\X2\2019\X0\,2-3; W60: balken verdieping +1: B+1 1,A-D / 2,A-D / 3,A-D / 4,A-D; W61: balken verdieping +2: B+2 A,1-4 / A\X2\2019\X0\,2-3 / B,1-4 / C,1-4 / C\X2\2019\X0\,1-4; W62: balken verdieping +2: B+2 1,A-D / 2,A-D / 3,A-D / 4,A-D; W63: wapening plaat boven +2, deel 1 as 1-4, A-D (basisnet 150/150/10/10); W64: balken verdieping +2: B+2 H\X2\2019\X0\,1-3 / I,1-4 / J,1-4 / K,1-4 / K\X2\2019\X0\,1-4 / L\X2\2019\X0\,3-4; W65: wapening plaat boven +2, deel 3 as 1-4, H-L; W66: wand op as L\X2\2019\X0\, van peil +27,28 tot +40,04; W67: wanden W39 en W40 (van peil +28,27 tot +22,90) en de wandjes op as 4/C\X2\2019\X0\-D en as 4/H-H\X2\2019\X0\; W68: balken verdieping +2: B+2 1,H-L / 2,H-L / 3,H-L / 4,H-L; W69: wapening plaat boven +3 (niveau +35,84), deel 1 as 1-4, A-D; W70: wapening plaat boven +3 (niveau +35,99), deel 3 as 1-4, H-L; W71: balken verdieping +3 (peil +35,99): B+3 H,1-4 / I,1-4 / J,1-4 / K,1-4 / K\X2\2019\X0\,1-4 / L\X2\2019\X0\,1-4; W72: balken verdieping +3 (peil +35,99): B+3 1,H-L / 2,H-L / 3,H-L / 4,H-L; W73: dakbalken verdieping +3: B+3 1,A-D / 2,A-D / 3,A-D / 4,A-D / A,1-4 / A\X2\2019\X0\,2-3 / A\X2\20192019\X0\,2-3 / C\X2\2019\X0\,2-3 / C\X2\20192019\X0\,2-3; W74: technische koker: wapening steunplaat ventilator (1/20); W75: dakbalken verdieping +4 (peil +39,82): B+4 1,H\X2\2019\X0\-L\X2\2019\X0\ t.e.m. 4,H\X2\2019\X0\-L\X2\2019\X0\ en B+4 H\X2\20192019\X0\ / J\X2\2019\X0\ / K\X2\2019\X0\ / K\X2\20192019\X0\; W76: wapening plaat boven +4 (niveau +39,72), deel 2 as 1-4, H-L; W77: wanden W39\X2\2019\X0\ / W39\X2\2019\X0\A / W39\X2\2019\X0\B / W39\X2\2019\X0\C; W78: wanden W40\X2\2019\X0\ / W40\X2\2019\X0\A / W40\X2\2019\X0\B / W40\X2\2019\X0\C; W79: kolommen 30\X2\00D7\X0\90 cm op de assen 3-H\X2\2019\X0\ en 2-H\X2\2019\X0\, tussen peil +35,99 en +39,72; W80: wapening van het bij te storten gedeelte ter plaatse van as A-2, peil +19,00 (1/20); W81: sokkel voor het vertikaal geleidingsprofiel in het auditorium (1/25); W82: opstand in de foyer (1/50-1/25); W83: console voor de ondervanging van de metselwerkwand (1/50); W84: opstand boven de liftkoker op as K (1/20); bijkomende metselwerkopstand naast de liftschacht (2009)'),$);
