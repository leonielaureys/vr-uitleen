#45337=IFCPROPERTYSINGLEVALUE('Hoogste punt',$,IFCLABEL('+45,93 volgens de oostgevel (lift- en technische kokers boven het dak). Niet gemodelleerd: de plattegronden tonen dat dakvolume niet.'),$);
#45338=IFCPROPERTYSINGLEVALUE('Maaiveld langs de straat',$,IFCLABEL('loopt van +18,49 tot +22,73 (pasaanduidingen op de gevel)'),$);
#45339=IFCPROPERTYSINGLEVALUE('Afwijking',$,IFCLABEL('De gevel geeft voor de tweede verdieping +31,19 en +31,765, het plan van 2010 geeft +32,22 (verschil 45 cm). Het model volgt het plan van 2010; de vloerzone is daar een aanname.'),$);
#45340=IFCPROPERTYSET('222EnOIYbF8xy6ktqVm1cg',$,'UFO_Draagstructuur',$,(#45342,#45343,#45344,#45345,#45346,#45347,#45348,#45349,#45350,#45351,#45352,#45353));
#45341=IFCRELDEFINESBYPROPERTIES('2kP$7RnJz6Zx6jw$HVhbdC',$,$,$,(#13),#45340);
#45342=IFCPROPERTYSINGLEVALUE('Bron',$,IFCLABEL('Bekistingsplannen S1 t.e.m. S48 (volledige reeks, enkel blad S9 ontbreekt), uitvoeringsdossier Project 255, stabiliteit N.V. studiebureau S.W.K. / ARCADIS Belgium, 2005-2009'),$);
#45343=IFCPROPERTYSINGLEVALUE('Systeem',$,IFCLABEL('Staalskelet met voorgespannen welfsels en een ter plaatse gestorte druklaag; onderbouw in gewapend beton op palen'),$);
#45344=IFCPROPERTYSINGLEVALUE('Kolommen',$,IFCLABEL('HD 400x651 van de fundering tot de eerste verdieping, HEM 400 op de tweede en derde verdieping (doorsnede 1-1, blad S11). Tussen de assen H en I lopen de stalen kolommen door van peil +35,99 tot +39,22 (blad S44, detail op 1/10).'),$);
#45345=IFCPROPERTYSINGLEVALUE('Structurele peilen',$,IFCLABEL('plaat boven verdieping +3 op +35,99 (bladen S45 en S46, bevestigd door de wapeningsplannen W70, W71 en W72); in de zone A-D ligt diezelfde plaat 15 cm lager, op +35,84 (W69). Het plan van 2010 geeft +36,13 als afgewerkte vloer, het verschil is de vloeropbouw. Stalen kolommen tot +39,22 (S44); de dakplaat ligt op +39,72 (W76), de dakbalken op +39,82 (W75) en de wand op as L\X2\2019\X0\ loopt tot +40,04 (W66), het dakpeil van dit model.'),$);
#45346=IFCPROPERTYSINGLEVALUE('Vloeren',$,IFCLABEL('080: funderingsplaat op palen, 35 cm (S1 \X2\2013\X0\ funderingsplaat verdieping -2); 090: plaat ter plaatse gestort, 25 cm (plaatselijk 15 cm) (S2 \X2\2013\X0\ plaat boven verdieping -2); 100: plaat ter plaatse gestort, 50 cm, op balken 65 cm (S3 \X2\2013\X0\ plaat boven verdieping -1); 110: voorgespannen welfsels + druklaag 10 cm, op balken 74 cm (S4 \X2\2013\X0\ plaat boven verdieping 0); 120: voorgespannen welfsels + druklaag 10 cm, op balken 74/58 cm (S5 \X2\2013\X0\ verdieping +2); 130: voorgespannen welfsels + druklaag 10 cm, op balken 58 cm (S6 \X2\2013\X0\ verdieping +3)'),$);
#45347=IFCPROPERTYSINGLEVALUE('Dak',$,IFCLABEL('voorgespannen welfsels 20 cm + druklaag 5 cm, op balken 60 cm (S7 \X2\2013\X0\ dakniveau as H\X2\2192\X0\L; S11 \X2\2013\X0\ doorsnede 1-1)'),$);
#45348=IFCPROPERTYSINGLEVALUE('Auditorium',$,IFCLABEL('stalen dakconstructie met vakwerkliggers en windverbanden boven het auditorium (blad S8)'),$);
#45349=IFCPROPERTYSINGLEVALUE('Fundering',$,IFCLABEL('funderingsplaat op palen, peil +15,82 / +15,52 (blad S1, doorsnede 1-1)'),$);
#45350=IFCPROPERTYSINGLEVALUE('Balken',$,IFCLABEL('genummerd per niveau: B-2 (plaat boven verdieping -2, bladen S21-S24), B-1 (S25-S30), B+1 (S35-S37 en S40), B+2 (S38-S39 en S41-S42), B+3 (S45-S46), B+4 (S48, dakstructuur)'),$);
#45351=IFCPROPERTYSINGLEVALUE('Wanden',$,IFCLABEL('technisch verdiep 90: WT1 t.e.m. WT23 (blad S31); trap B: W43 t.e.m. W48 van +18,93 tot +36,13 (blad S33); trap A: W49 t.e.m. W53 en WT22 van +18,93 tot +40,04 (blad S34); W39'' t.e.m. W40''C (blad S47)'),$);
#45352=IFCPROPERTYSINGLEVALUE('Doorsneden',$,IFCLABEL('1-1 t.e.m. 12-12 (bladen S11 t.e.m. S20, S32 en S43)'),$);
#45353=IFCPROPERTYSINGLEVALUE('Niet in deze reeks',$,IFCLABEL('blad S9 ontbreekt. Bekistingsplannen geven de vorm en de materialen, niet de staafwapening zelf; daarvoor zijn de wapeningsplannen en buigstaten nodig.'),$);
