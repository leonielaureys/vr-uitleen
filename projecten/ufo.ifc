#45356=IFCPROPERTYSINGLEVALUE('Bron',$,IFCLABEL('Wapeningsplannen W1 t.e.m. W84 (uitvoeringsdossier Project 255, S.W.K. / ARCADIS, 2007-2009)'),$);
#45357=IFCPROPERTYSINGLEVALUE('Overgenomen',$,IFCLABEL('blad W5 (kolommen niveau -2), blad W23 (balken as C en as D boven verdieping -2) en blad W57 (cassettevloer boven +1, zone H-L): staaf per staaf uitgeschreven zoals de plannen ze geven \X2\2014\X0\ diameters, lengtes, aantallen, beugelafstanden en staafmerken'),$);
#45358=IFCPROPERTYSINGLEVALUE('Als staaf gemodelleerd',$,IFCLABEL('de zes ovale kolommen op de letterassen C, D en I van niveau -2 (blad W5). Hun W5-type is hetzelfde op as 2 als op as 3, zodat ze zonder gissen te leggen zijn.'),$);
#45359=IFCPROPERTYSINGLEVALUE('Nog niet als staaf gemodelleerd',$,IFCLABEL('de tien overige ovale kolommen (letters E, F, G, H en J) en alle balken, platen en wanden. Voor de tien kolommen verschilt het W5-type tussen as 2 en as 3, en welke van de twee binnenste dwarslijnen as 2 is, ligt nog niet vast. Voor de rest ontbreken de elementen zelf in de documentatieplannen van 2010. De gegevens van de bladen staan hierboven wel volledig.'),$);
#45360=IFCPROPERTYSINGLEVALUE('Stramien teruggevonden',$,IFCLABEL('letterassen A t.e.m. L om de 8,80 m, richting 82,93\X2\00B0\X0\, as A aan de zijde van de zone die op +3 stopt (W69, W73) en as L aan de zijde met de plaat boven +4 (W75, W76). Cijferassen: vier dwarslijnen; de twee binnenste dragen elk acht ovale kolommen op de letters C t.e.m. J \X2\2014\X0\ precies wat W5 voor as 2 en as 3 opsomt.'),$);
#45361=IFCPROPERTYSINGLEVALUE('Kolommen C-2, D-2, E-2, C-3, D-3',$,IFCLABEL('5 \X2\00D7\X0\ | ovale kolom; beugel 860 \X2\00D7\X0\ 160 mm met R = 160 mm | langs: S1: 2\X2\00D7\X0\8 \X2\00D8\X0\28 \X2\00D7\X0\ 3300 mm; S2: 2\X2\00D7\X0\7 \X2\00D8\X0\28 \X2\00D7\X0\ 3300 mm | beugels: S3: 2\X2\00D7\X0\16 \X2\00D8\X0\12 \X2\00D7\X0\ 2220 mm alle 150 mm | staal BE 500S | blad W5 (2007)'),$);
#45362=IFCPROPERTYSINGLEVALUE('Kolommen E-3, F-3, G-3, H-3, J-3',$,IFCLABEL('5 \X2\00D7\X0\ | ovale kolom; beugel 860 \X2\00D7\X0\ 160 mm met R = 160 mm | langs: S5: 2\X2\00D7\X0\6 \X2\00D8\X0\32 \X2\00D7\X0\ 3400 mm; S6: 2\X2\00D7\X0\9 \X2\00D8\X0\32 \X2\00D7\X0\ 3400 mm | beugels: S7: 2\X2\00D7\X0\16 \X2\00D8\X0\12 \X2\00D7\X0\ 2220 mm alle 150 mm | staal BE 500S | blad W5 (2007)'),$);
