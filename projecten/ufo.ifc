#45334=IFCPROPERTYSINGLEVALUE('Peilen op de gevel',$,IFCLABEL('+15,50 / +15,90 / +18,18 / +19,13 / +22,01 / +23,04 / +25,25 / +27,425 / +28,31 / +29,595 / +31,19 / +31,765 / +33,935 / +35,10 / +36,185 / +39,01 / +40,095 / +45,93'),$);
#45335=IFCPROPERTYSINGLEVALUE('Vloerzones (onderkant \X2\2192\X0\ vloer)',$,IFCLABEL('080: gevel 2005: onderkant +15,50 \X2\2192\X0\ vloer +15,90; 090: gevel 2005: onderkant +18,18 \X2\2192\X0\ vloer +19,13; 100: gevel 2005: onderkant +22,01 \X2\2192\X0\ vloer +23,04; 110: gevel 2005: onderkant +27,425 \X2\2192\X0\ vloer +28,31; 120: aanname: de gevel geeft +31,19 en +31,765, het plan van 2010 geeft +32,22; 130: gevel 2005: onderkant +35,10 \X2\2192\X0\ vloer +36,185'),$);
