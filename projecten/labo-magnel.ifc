#557754=IFCPROPERTYSINGLEVALUE('Staven',$,IFCLABEL('4 \X2\00D8\X0\18 \X2\00D7\X0\ 4,10 m in de hoeken; 14 beugels \X2\00D8\X0\8 \X2\00D7\X0\ 1,14 m alle 25 cm'),$);
#557755=IFCPROPERTYSINGLEVALUE('Op het plan',$,IFCLABEL('K2\X2\2013\X0\K12, K16\X2\2013\X0\K26, K32\X2\2013\X0\K42, K126\X2\2013\X0\K134, K140\X2\2013\X0\K152, K156\X2\2013\X0\K166 (66 st. op het plan). OB75 geeft daarnaast nog 4 kolommen 30/30 met 13 in plaats van 14 beugels: K27, K28, K135 en K136.'),$);
